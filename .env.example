# Bu fayldan .env nusxa oling. Django .env ni avtomatik o'qiydi.
# Server muhitidagi o'zgaruvchilar .env dan ustun turadi.
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME-BEFORE-PRODUCTION-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram bot: qiymatlarni server muhitida o'rnating
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STAFF_CHAT_ID=
# auto: DEBUG=True bo'lsa polling, DEBUG=False bo'lsa webhook.
# Boshqa variantlar: polling, webhook, disabled.
TELEGRAM_BOT_MODE=disabled
# Production webhook uchun tashqi HTTPS domen (yo'lsiz).
TELEGRAM_PUBLIC_URL=
# runserver va serve bilan eslatma, hisobot va Telegram navbatini ham boshlash.
CRM_BACKGROUND_JOBS=True

# Ma'lumotlar bazasi: 'sqlite' yoki 'postgres' (Production uchun 'postgres' tavsiya etiladi)
DB_ENGINE=sqlite
# DB_ENGINE=postgres bo'lsa:
DB_NAME=sargetcrm
DB_USER=sargetuser
DB_PASSWORD=parol_kiriting
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Alohida tashqi bot REST API ishlatilsa kuchli, tasodifiy kalit kiriting.
# Bo'sh bo'lsa REST API yopiq; ichki polling/webhook bot ishlashda davom etadi.
CRM_API_KEY=

# Production: DJANGO_DEBUG=False va kuchli, tasodifiy DJANGO_SECRET_KEY.
# HTTPS tayyor bo'lgach quyidagilarni hostingga mos sozlang.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0

# --- Bot alohida serverda ishlaganda (docs/BOT_ALOHIDA_SERVER.md) ---
# CRM Telegramdan xabar QABUL QILMAYDI (buni bot serveri qiladi); yuborish tokeni bilan davom etadi
# Bot serveridagi CRM_API_KEY bilan AYNAN bir xil bo'lsin
