# Replace domain, certificate locations and /srv/sargetcrm with the actual server paths.
server {
    listen 80;
    server_name crm.milliycrm.uz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name crm.milliycrm.uz;
    ssl_certificate /etc/letsencrypt/live/crm.milliycrm.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crm.milliycrm.uz/privkey.pem;
    client_max_body_size 6m;

    location /static/ {
        alias /srv/sargetcrm/staticfiles/;
    }
    location /media/ {
        alias /srv/sargetcrm/media/;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
    }
}
